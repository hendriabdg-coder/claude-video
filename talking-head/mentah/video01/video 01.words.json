 "segments": [
  {
   "start": 0.0,
   "end": 3.62,
   "text": "Jangan pernah minta AI nentuin harga jualanmu. Ini alasannya."
  },
  {
   "start": 3.68,
   "end": 8.74,
   "text": "Coba tanya AI, harga nasi kotak yang pas berapa? Jawabannya meyakinkan. Tapi angkanya dari mana?"
  },
  {
   "start": 9.02,
   "end": 14.8,
   "text": "AI nggak tahu harga bahan di pasar deket rumahmu, ongkos gas, sewa tempat, atau gaji karyawanmu."
  },
  {
   "start": 15.16,
   "end": 17.42,
   "text": "Dia juga nggak tahu daya beli pelanggan di daerahmu."
  },
  {
   "start": 17.82,
   "end": 23.14,
   "text": "Jadi yang dia kasih cuma tebakan rata-rata dari internet. Bisa bikin rugi, bisa kemahalan."
  },
  {
   "start": 23.4,
   "end": 28.52,
   "text": "Terus AI gunanya apa? Kasih dia semua biayamu, minta hitung modal per porsi,"
  },
  {
   "start": 28.52,
   "end": 30.36,
   "text": "dan biaya yang mungkin kamu lupa."
  },
  {
   "start": 30.78,
   "end": 34.42,
   "text": "Hitungannya boleh dibantu AI. Keputusan harganya tetap di kamu."
  },
  {
   "start": 34.74,
   "end": 36.06,
   "text": "Follow buat tips berikutnya."
  }
 ],
