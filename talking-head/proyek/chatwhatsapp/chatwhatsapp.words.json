{
 "language": "id",
 "duration": 57.376,
 "model": "large-v3-turbo (faster-whisper)",
 "segments": [
  {
   "start": 0.0,
   "end": 9.44,
   "text": "Coba bayangin ya, kamu punya usaha. Jam 9 malam, badan udah capek, tapi pas buka WhatsApp masih ada belasan chat yang belum kebales."
  },
  {
   "start": 9.66,
   "end": 17.38,
   "text": "Ada yang nanya harga, stok, sampai besok buka jam berapa. Terus kamu mikir, ah besok pagi aja deh balesnya."
  },
  {
   "start": 18.04,
   "end": 25.42,
   "text": "Masalahnya, pelanggan belum tentu mau nunggu. Kalau dia butuh sekarang, dia tinggal chat toko lain, dibales lebih cepet, yaudah pindah."
  },
  {
   "start": 25.42,
   "end": 33.02,
   "text": "Dan ini bukan karena kamu nggak niat ngurus pelanggan. Kamu juga manusia, nggak mungkin pegang HP 24 jam."
  },
  {
   "start": 33.28,
   "end": 41.12,
   "text": "Cuma mungkin sistem bisnismu yang belum bantu. Karena pertanyaan soal harga, jam buka, lokasi, atau cara booking sebenarnya bisa dijawab otomatis."
  },
  {
   "start": 41.34,
   "end": 49.06,
   "text": "Tapi bukan berarti semua chat dikasih ke AI. Kalau sudah komplain, negosiasi, refund, atau kasus yang aneh, tetap manusia yang pegang."
  },
  {
   "start": 49.26,
   "end": 55.24,
   "text": "Jadi tujuannya bukan mengganti admin. Kalau usaha kamu ngalamin hal yang sama, mungkin yang perlu dibenerin"
  },
  {
   "start": 55.24,
   "end": 57.08,
   "text": "Dan bukan orangnya, tapi sistemnya."
  }
 ],
