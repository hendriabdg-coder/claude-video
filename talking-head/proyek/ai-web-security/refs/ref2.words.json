 "segments": [
  {
   "start": 0.0,
   "end": 2.32,
   "text": "Sebenernya kasihan banget pak editor yang kerja sendirian."
  },
  {
   "start": 2.42,
   "end": 6.84,
   "text": "Harusnya fokus sama creative direction, malah capek sama pekerjaan-pekerjaan yang repetitif."
  },
  {
   "start": 6.92,
   "end": 10.32,
   "text": "Foldering, software aset, bikin proksi, transkrip, sampe ngurusin invoice."
  },
  {
   "start": 10.46,
   "end": 13.14,
   "text": "Kalo misalkan udah kayak gitu, gimana mau naikin red card?"
  },
  {
   "start": 13.22,
   "end": 17.88,
   "text": "Jadi aku pake Hermes Agent, model AI yang berjalan lokal di laptop dan terhubung ke Telegram."
  },
  {
   "start": 18.0,
   "end": 20.74,
   "text": "Tinggal kirim intruksi lewat Telegram dimanapun dan kapanpun,"
  },
  {
   "start": 20.9,
   "end": 23.9,
   "text": "terus dia bakal ngerjain semuanya langsung sendirian secara lokal."
  },
  {
   "start": 24.04,
   "end": 28.04,
   "text": "Mulai dari software aset, folder ring, kasih brief, kadang juga aku minta dia reminder jadwal meeting,"
  },
  {
   "start": 28.04,
   "end": 32.08,
   "text": "sampe cari ide konten dan berita terkini setiap hari tanpa harus disuruh lagi."
  },
  {
   "start": 32.22,
   "end": 33.28,
   "text": "Gini rahasianya pak."
  },
  {
   "start": 33.4,
   "end": 37.94,
   "text": "Model AI dan tools pengolah filenya itu jalan lokal di laptop Asus Pro Art Go Pro Edition"
  },
  {
   "start": 37.94,
   "end": 41.82,
   "text": "yang ditenagai prosesor AMD Ryzen AI Max Plus 395."
  },
  {
   "start": 42.0,
   "end": 46.34,
   "text": "Model dan tools lokalnya ini gratis, jadi kita punya asisten pribadi yang pintar"
  },
  {
   "start": 46.34,
   "end": 49.24,
   "text": "tanpa harus ngeluarin budget tambahan buat langganan AI Cloud."
  },
  {
   "start": 49.36,
   "end": 50.6,
   "text": "Produktif dan murah banget."
  },
  {
   "start": 50.84,
   "end": 53.08,
   "text": "Prosesornya ini, dia kan kenceng banget ya pak ya."
  },
  {
   "start": 53.16,
   "end": 55.38,
   "text": "Dia punya 16 core dan 32 thread."
  },
  {
   "start": 55.38,
   "end": 60.36,
   "text": "Jadi ngedukung banget buat multitasking edit video berat sekaligus running lokal AI secara bersamaan."
  },
  {
   "start": 60.58,
   "end": 65.52,
   "text": "Prosesor AMD Ryzen AI Max Series juga didukung unified memory sampai 128GB"
  },
  {
   "start": 65.52,
   "end": 70.0,
   "text": "yang dapat digunakan secara bersamaan oleh CPU, GPU, dan juga MPU."
  },
  {
   "start": 71.2,
   "end": 72.18,
   "text": "128GB pak."
  },
  {
   "start": 72.38,
   "end": 76.06,
   "text": "Astaga, aplikasi dan model AI kompleks apa yang gak bisa dilibas?"
  },
  {
   "start": 76.16,
   "end": 82.5,
   "text": "Kalau urusan visual, dia dibantu grafis terintegrasi AMD Radeon 8060s dengan 40 complete unit."
  },
  {
   "start": 82.5,
   "end": 87.58,
   "text": "Kartu grafis di AMD Ryzen AI Max Plus Series ini setara dengan kartu grafis diskret modern."
  },
  {
   "start": 87.72,
   "end": 92.0,
   "text": "Jadi cocok banget buat para editor, animator, ilustrator, dan pekerja kreatif lainnya."
  },
  {
   "start": 92.08,
   "end": 96.04,
   "text": "Intinya pak, prosesor AMD Ryzen AI Max Plus 395 ini bisa jadi pendukung"
  },
  {
   "start": 96.04,
   "end": 98.74,
   "text": "supaya pekerjaan repetitif bisa dibantu sama agent"
  },
  {
   "start": 98.74,
   "end": 102.04,
   "text": "dan kita fokus ke visi utama dari kreatif itu sendiri."
  },
  {
   "start": 102.24,
   "end": 106.08,
   "text": "Kalau ada AMD Ryzen AI Max Series di laptopmu sih harusnya aman ya pak ya?"
  },
  {
   "start": 106.24,
   "end": 107.46,
   "text": "Sekian dari ku, kemau kontenmu."
  }
